#!/bin/sh
set -eu
IFS= read -r subject < "$1" || true
case "$subject" in
  Merge*) exit 0 ;;
esac
if ! printf '%s\n' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]+\))?!?: .+'; then
  printf '%s\n' 'Use a Conventional Commit subject: type(scope): description' >&2
  exit 1
fi
